# ==============================================================================
# SCHOLARGUARD / TURNITIN CLONE PRODUCTION CONFIGURATION
# ==============================================================================

# Core Django Settings
# Generate a secret key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-secure-50-character-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-production-domain.com

# CSRF Trusted Origins (Required for POST requests over HTTPS in Django 4+)
CSRF_TRUSTED_ORIGINS=https://your-production-domain.com,http://localhost:8000

# ------------------------------------------------------------------------------
# Database Options
# Option 1: DATABASE_URL (Recommended for Cloud / Docker / Heroku / Render / Railway)
# DATABASE_URL=mysql://dbuser:dbpass@localhost:3306/plagiarism_db
# DATABASE_URL=postgresql://dbuser:dbpass@localhost:5432/plagiarism_db
# DATABASE_URL=sqlite:///db.sqlite3

# Option 2: Individual variables
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# Production Security & SSL Settings
# Set SECURE_SSL_REDIRECT to True if SSL is not terminated at a reverse proxy
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ------------------------------------------------------------------------------
# Document Upload & Processing Limits
MAX_UPLOAD_SIZE_MB=25
MAX_PAGES=500
MAX_WORDS=100000
PROCESSING_TIMEOUT_SECONDS=300

# ------------------------------------------------------------------------------
# Plagiarism & Similarity Engine Parameters
DEFAULT_SIMILARITY_THRESHOLD=15
MIN_MATCH_WORD_COUNT=5
NGRAM_SIZE=5

# ------------------------------------------------------------------------------
# Data Retention
DOCUMENT_RETENTION_DAYS=365
REPORT_RETENTION_DAYS=730

# ------------------------------------------------------------------------------
# Optional Email Configuration (for password reset & alerts)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ScholarGuard <no-reply@your-production-domain.com>
